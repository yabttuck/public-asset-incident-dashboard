# Copy these values from the Supabase development project into .env.local.
# Keep local credentials in .env.local; never add them to Git.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: enables the shared admin login for the sample Supabase project.
TEST_ADMIN_PASSWORD=
# Optional: active reporter test account in the sample Supabase project.
TEST_REPORTER_EMAIL=
TEST_REPORTER_PASSWORD=
# Optional: GA4 web stream for the public landing page.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional: Slack incoming webhook for urgent incident alerts.
SLACK_INCIDENT_WEBHOOK_URL=
# Public deployment origin used to build incident links in Slack.
NEXT_PUBLIC_APP_URL=
